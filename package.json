{
  "name": "tanukarr",
  "version": "0.1.0",
  "description": "Tanukarr manages TV series and anime with per-series TheTVDB, TMDB, AniList and MyAnimeList metadata for Usenet and BitTorrent users",
  "type": "module",
  "scripts": {
    "build": "yarn clean && vite build",
    "clean": "rimraf ./_output/UI && rimraf --glob \"**/*.js.map\"",
    "start": "vite",
    "watch": "vite build --watch",
    "types:css": "tcm frontend/src --camelCase --pattern \"**/*.module.css\"",
    "typecheck": "yarn types:css && tsc --noEmit -p frontend/tsconfig.json",
    "test:queue-details": "node --test frontend/tests/queueDetails.test.cjs frontend/tests/episodeBatches.test.cjs frontend/tests/metadataIdentity.test.cjs frontend/tests/addSeriesModal.test.cjs frontend/tests/animeGrouping.test.cjs frontend/tests/groupNamingAndSearch.test.cjs frontend/tests/anilistListChoices.test.cjs frontend/tests/seriesImageInterop.test.cjs frontend/tests/oauthCallback.test.cjs frontend/tests/providerListChoices.test.cjs frontend/tests/qualityHourlyLimits.test.cjs frontend/tests/collections.test.cjs frontend/tests/customQualities.test.cjs frontend/tests/metadataSources.test.cjs frontend/tests/timeZoneData.test.cjs frontend/tests/lintPolicies.test.cjs frontend/tests/libraryImport.test.cjs",
    "test:metadata-sources": "node --test frontend/tests/metadataSources.test.cjs",
    "test:add-series-modal": "node --test frontend/tests/addSeriesModal.test.cjs",
    "test:anime-grouping": "node --test frontend/tests/addSeriesModal.test.cjs frontend/tests/animeGrouping.test.cjs",
    "lint": "eslint --config frontend/eslint.config.cjs frontend/",
    "lint-fix": "yarn lint --fix",
    "stylelint": "stylelint \"frontend/**/*.css\" --config frontend/.stylelintrc"
  },
  "repository": "https://github.com/KvasFan/Tanukarr.git",
  "author": "Team Sonarr",
  "license": "GPL-3.0",
  "readmeFilename": "readme.md",
  "main": "index.ts",
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fastify/deepmerge": "3.2.2",
    "@floating-ui/react": "0.27.20",
    "@fluentui/priority-overflow": "9.4.3",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@juggle/resize-observer": "3.4.0",
