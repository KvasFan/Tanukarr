    "autoprefixer": "10.6.1",
    "core-js": "3.50.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "4.2.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.26.7",
