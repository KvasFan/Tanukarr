    "globals": "17.13.0",
    "postcss": "8.5.29",
    "postcss-custom-media": "12.0.3",
    "postcss-mixins": "12.1.2",
    "postcss-nested": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "rimraf": "6.1.3",
    "stylelint": "17.16.0",
    "stylelint-order": "8.1.2",
    "type-fest": "5.10.0",
